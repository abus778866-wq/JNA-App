{
  "name": "jamia-noor-ul-anwar",
  "version": "1.15.0",
  "description": "School management system for Jamia Noor-ul-Anwar (Boys & Girls sections)",
  "main": "main.js",
  "author": "Jamia Noor-ul-Anwar",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./src/styles.css --minify",
    "start": "npm run build:css && electron .",
    "dist": "npm run build:css && electron-builder --win nsis",
    "build:www": "npm run build:css && node scripts/build-www.mjs",
    "android:add": "npx cap add android",
    "android:assets": "npx capacitor-assets generate --android --assetPath resources",
    "android:sync": "npm run build:www && npx cap sync android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "sql.js": "^1.10.3",
    "xlsx": "^0.18.5",
    "@capacitor/core": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "jamia-storage": "file:plugins/jamia-storage"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "tailwindcss": "^3.4.10",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/assets": "^3.0.5",
    "esbuild": "^0.25.0",
    "@noble/hashes": "^1.8.0",
    "buffer": "^6.0.3",
    "path-browserify": "^1.0.1",
    "fflate": "^0.8.2"
  },
  "build": {
    "appId": "org.jamia.noorulanwar",
    "productName": "Jamia Noor-ul-Anwar",
    "files": [
      "main.js",
      "preload.js",
      "database.js",
      "index.html",
      "locations.js",
      "renderer.js",
      "animations.js",
      "assets/*.png",
      "theme.js",
      "logo.png",
      "icon.png",
      "src/styles.css",
      "package.json",
      "mobile-ui.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
